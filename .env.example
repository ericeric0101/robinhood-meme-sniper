# Environment variables for Robinhood Meme Sniper
# Copy to .env and fill secrets locally. Never commit real .env.

# --- core app ---
APP_ENV=development
LOG_LEVEL=INFO
CHAIN_ID=robinhood
DATA_DIR=./data
OUTPUT_DIR=./outputs
SQLITE_PATH=./data/state.db
POLL_INTERVAL_SECONDS=180
EARLY_WINDOW_MINUTES=180
ALERT_COOLDOWN_MINUTES=60

# --- X / Twitter ingestion ---
# Provider selector: apify | twitterapiio
# Current default remains apify until another provider is fully wired.
X_PROVIDER=apify

# Option A: Apify actor (recommended first for Phase 1 + 2 prototype)
APIFY_API_TOKEN=
# Default prototype source: xtdata/twitter-x-scraper
# Notes: searchTerms mode works, but this actor is better for low-frequency historical/prototype runs than high-frequency polling.
APIFY_X_ACTOR_ID=xtdata~twitter-x-scraper
APIFY_X_MAX_ITEMS=100

# Option B: TwitterAPI.io (advanced search + user timeline wired)
TWITTERAPIIO_API_KEY=
# Official skill / docs alias also accepted by this repo:
TWITTERAPI_IO_KEY=

# Option C: Official X API / xurl-backed config
# Preferred long term if you want better control and fewer scraping dependencies.
X_APP_NAME=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_USERNAME=
# If using xurl locally, tokens are managed by xurl, not stored here.
# These env vars are mostly for app config / future direct API clients.

# --- tracking DB / retention / judge ---
TRACKING_DB_PATH=./data/tracking.db
TRACKING_RETENTION_DAYS=180
# Optional: if you later want to drop long-stale tracked tokens too
TRACKING_DROP_STALE_TOKENS_DAYS=

# Optional LLM judge for Phase C-2 broad-discovery denoise
TRACKING_JUDGE_ENABLED=false
TRACKING_JUDGE_ENDPOINT=
TRACKING_JUDGE_API_KEY=
TRACKING_JUDGE_MODEL=
TRACKING_JUDGE_TIMEOUT_SECONDS=30

# Optional LLM judge for D-2.5 KOL lifecycle event gray areas.
# If endpoint/key/model are blank, this falls back to the TRACKING_JUDGE_* values above.
EVENT_JUDGE_ENABLED=false
EVENT_JUDGE_ENDPOINT=
EVENT_JUDGE_API_KEY=
EVENT_JUDGE_MODEL=
EVENT_JUDGE_TIMEOUT_SECONDS=30

# --- Telegram alert delivery ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- market data ---
# Public endpoints may work without keys at first.
DEXSCREENER_BASE_URL=https://api.dexscreener.com
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2

# --- optional explorer / enrichment ---
# Fill only if you decide to use an explorer or RPC provider later.
ROBINHOOD_RPC_URL=
EXPLORER_API_KEY=
EXPLORER_BASE_URL=

# --- heuristics ---
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_1H_USD=2000
MIN_AUTHENTICITY_SCORE=80
MIN_MARKET_SCORE=55
MIN_ALERT_SCORE=75
MAX_CLUSTER_ALIAS_COUNT=20

# --- optional future Phase 3 placeholders (do not use yet) ---
AUTO_BUY_ENABLED=false
AUTO_BUY_MAX_USD=10
AUTO_BUY_DAILY_LIMIT_USD=30
WALLET_PRIVATE_KEY=
EXECUTOR_RPC_URL=
